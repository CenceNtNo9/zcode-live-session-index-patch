+  const events: string[] = [];
+  const subscription = syncer
+    .onDynamicWorkspaceEvent({ workspacePath: workspacePathA, workspaceIdentity: workspaceIdentityA })(
+      (event) => {
+        if (
+          event.type === "workspace_task_list_changed" &&
+          event.taskId === "external-retry-session"
+        ) {
+          events.push(event.reason);
+        }
+      },
+    );
+
+  try {
+    syncer.ensureWorkspaceSubscription({
+      workspacePath: workspacePathA,
+      workspaceIdentity: workspaceIdentityA,
+    });
