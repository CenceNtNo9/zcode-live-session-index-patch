+for (const failure of ["group", "post-read", "post-read-and-retry-read"] as const) {
+  test("post-seed " + failure + " failure resumes admission without losing the pending row", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "zcode-live-post-seed-"));
+    const repo = new TaskIndexRepo(join(directory, "tasks.sqlite"));
+    const taskId = "post-seed-" + failure;
+    const getMeta = repo.getTaskMeta.bind(repo);
+    const group = repo.initializeGroupedTaskAtTop.bind(repo);
+    const seed = repo.seedTaskMetaIfMissing.bind(repo);
+    let seeds = 0;
+    let groups = 0;
+    let failedReads = 0;
+    let readFailurePending = false;
+    repo.seedTaskMetaIfMissing = async (meta) => {
+      const result = await seed(meta);
+      if (meta.taskId === taskId) seeds += 1;
+      return result;
+    };
+    repo.initializeGroupedTaskAtTop = async (params) => {
+      if (params.taskId === taskId) {
+        groups += 1;
+        if (groups === 1 && failure === "group") throw new Error("injected post-seed group failure");
+        if (groups === 1 && failure !== "group") readFailurePending = true;
+      }
+      return group(params);
+    };
+    repo.getTaskMeta = async (params) => {
+      if (params.taskId === taskId && (readFailurePending || (failure === "post-read-and-retry-read" && failedReads === 1))) {
+        readFailurePending = false;
+        failedReads += 1;
+        throw new Error("injected pending membership read failure");
+      }
+      return getMeta(params);
+    };
+    const provider = createProviderFreeAgentService();
+    const syncer = createZCodeTaskIndexSyncer({ agentService: provider.service, taskIndexRepo: repo });
+    const service = createZCodeTaskServiceAdapter({ zcodeAgentService: provider.service, taskIndexRepo: repo, taskIndexSyncer: syncer });
+    const events: string[] = [];
+    const subscription = syncer.onDynamicWorkspaceEvent({ workspacePath: workspacePathA, workspaceIdentity: workspaceIdentityA })((event) => {
+      if (event.type === "workspace_task_list_changed" && event.taskId === taskId) events.push(event.reason);
+    });
+    const publish = (at: number) => provider.publishSummary(workspaceIdentityA, summary({ sessionId: taskId, workspaceId: workspaceIdentityA, title: "Pending title", titleSource: "generated", lastActivityAt: at }));
+    try {
+      syncer.ensureWorkspaceSubscription({ workspacePath: workspacePathA, workspaceIdentity: workspaceIdentityA });
+      await waitFor(async () => (await visibleTasks(service, workspacePathA, workspaceIdentityA)).some((row) => row.taskId.startsWith("anchor-")), "initial seed");
+      publish(anchorAt + 1000);
+      await waitFor(() => failure === "group" ? groups === 1 : failedReads === 1, "injected post-seed failure");
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      assert.equal(seeds, 1);
+      assert.deepEqual(events, []);
+      if (failure === "post-read-and-retry-read") {
+        publish(anchorAt + 2000);
+        await waitFor(() => failedReads === 2, "second pending read failure");
+        await new Promise<void>((resolve) => setImmediate(resolve));
+        assert.deepEqual(events, []);
+      }
+      publish(anchorAt + 3000);
+      await waitFor(() => events.length === 1, "pending row admission");
+      assert.equal(seeds, 1, "successful insert must not repeat after a post-seed failure");
+      assert.deepEqual(events, ["task_created"]);
+      assert.ok((await visibleTasks(service, workspacePathA, workspaceIdentityA)).some((row) => row.taskId === taskId));
+      publish(anchorAt + 4000);
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      assert.equal(seeds, 1);
+      assert.deepEqual(events, ["task_created"]);
+      assert.equal(provider.readSessionCalls(), 0);
+    } finally {
+      subscription.dispose();
+      service.disposeAll();
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+}
