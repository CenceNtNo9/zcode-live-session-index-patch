+  const events: string[] = [];
+  const subscription = syncer
+    .onDynamicWorkspaceEvent({ workspacePath: workspacePathA, workspaceIdentity: workspaceIdentityA })(
+      (event) => {
+        if (
+          event.type === "workspace_task_list_changed" &&
+          event.taskId === targetTaskId
+        ) {
+          events.push(event.reason);
+        }
+      },
+    );
+
+  try {
+    syncer.ensureWorkspaceSubscription({
+      workspacePath: workspacePathA,
+      workspaceIdentity: workspaceIdentityA,
+    });
+    await waitFor(
+      async () =>
+        (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+          (row) => row.taskId === "anchor-" + workspaceIdentityA,
+        ),
+      "the current workspace task-index subscription to become ready",
+    );
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: targetTaskId,
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic generated title",
+        titleSource: "generated",
+        lastActivityAt: anchorAt + 20_000,
+      }),
+    );
+    await waitFor(
+      async () =>
+        tombstoneInjected &&
+        (await repo.listDeletedTaskIds({
+          workspacePath: workspacePathA,
+          workspaceIdentity: workspaceIdentityA,
+        })).includes(targetTaskId),
+      "the injected delete to commit before grouped admission",
+    );
+    await new Promise<void>((resolve) => setImmediate(resolve));
+
+    assert.deepEqual(await repo.listDeletedTaskIds({
+      workspacePath: workspacePathA,
+      workspaceIdentity: workspaceIdentityA,
+    }), [targetTaskId]);
+    assert.equal(
+      (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+        (row) => row.taskId === targetTaskId,
+      ),
+      false,
+    );
+    assert.deepEqual(events, [], "a tombstoned row must not broadcast as a new membership");
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: targetTaskId,
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic generated title",
