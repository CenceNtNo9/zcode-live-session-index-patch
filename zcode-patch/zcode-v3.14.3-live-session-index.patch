@@ -0,0 +1,195 @@
+import { watch, type FSWatcher } from "node:fs";
+import { basename, dirname, resolve } from "node:path";
+
+type InvalidationListener = {
+  onError?: (error: unknown) => void;
+  onInvalidate: () => void;
+};
+
+/**
+ * Turns cross-connection SQLite commits into advisory invalidations. SQLite remains the only
+ * source of truth: data_version is checked on the store's existing connection. Filesystem events
+ * are a low-latency hint; an active listener also gets a bounded one-second version check because
+ * Windows does not reliably report writes to an already-open WAL through fs.watch.
+ */
+export class SqliteExternalSessionIndexWatcher {
+  private readonly listeners = new Map<number, InvalidationListener>();
+  private readonly databasePath: string | null;
+  private readonly databaseName: string | null;
+  private nextListenerId = 0;
+  private watcher: FSWatcher | null = null;
+  private debounceTimer: ReturnType<typeof setTimeout> | null = null;
+  private versionCheckTimer: ReturnType<typeof setInterval> | null = null;
+  private lastDataVersion: number | null = null;
+  private disposed = false;
+
+  constructor(
+    dbPath: string,
+    private readonly readDataVersion: () => number,
+    private readonly debounceMs = 30,
+    private readonly pollIntervalMs = 1_000,
+  ) {
+    if (!Number.isFinite(debounceMs) || debounceMs < 0) {
+      throw new Error("SQLite session index watcher debounce must be non-negative");
+    }
+    if (!Number.isFinite(pollIntervalMs) || pollIntervalMs < 100 || pollIntervalMs > 10_000) {
+      throw new Error("SQLite session index watcher interval must be between 100 and 10000 ms");
+    }
+    this.databasePath = dbPath === ":memory:" ? null : resolve(dbPath);
+    this.databaseName = this.databasePath ? basename(this.databasePath) : null;
+  }
+
+  subscribe(onInvalidate: () => void, onError?: (error: unknown) => void): () => void {
+    if (this.disposed) throw new Error("SQLite session index watcher is disposed");
+    const id = this.nextListenerId++;
+    this.listeners.set(id, { onInvalidate, onError });
+    this.startWatching();
+
+    let unsubscribed = false;
+    return () => {
+      if (unsubscribed) return;
+      unsubscribed = true;
+      this.listeners.delete(id);
+      if (this.listeners.size === 0) this.stopWatching();
+    };
+  }
+
+  dispose(): void {
+    if (this.disposed) return;
+    this.disposed = true;
+    this.stopWatching();
+    this.listeners.clear();
+  }
+
+  private startWatching(): void {
+    const databasePath = this.databasePath;
+    if (!databasePath || this.disposed || this.listeners.size === 0) return;
+    if (!this.watcher) {
+      try {
+        const watcher = watch(dirname(databasePath), { persistent: false }, (_event, fileName) => {
+          if (this.isDatabaseFileEvent(fileName)) this.scheduleDataVersionCheck();
+        });
+        this.watcher = watcher;
+        watcher.on("error", (error) => this.handleWatcherError(watcher, error));
+      } catch (error) {
+        // The version check remains authoritative when this platform cannot create fs.watch.
+        this.reportError(error);
+      }
+    }
+    // Establish the connection-local baseline synchronously in subscribe(), before the gateway
+    // sends its initial index snapshot. The timer below only runs while a listener is registered.
+    if (this.lastDataVersion === null) {
+      try {
+        this.lastDataVersion = this.readDataVersion();
+      } catch (error) {
+        if (!this.isTransientBusyError(error)) this.reportError(error);
+      }
+    }
+    this.startVersionChecks();
+  }
+
+  private isDatabaseFileEvent(fileName: string | Buffer | null): boolean {
+    // Some platforms omit the changed name; a version check remains safe and inexpensive.
+    if (fileName === null) return true;
+    const changedName = fileName.toString();
+    const databaseName = this.databaseName;
+    if (!databaseName) return false;
+    const lowerChangedName = changedName.toLowerCase();
+    const lowerDatabaseName = databaseName.toLowerCase();
+    return (
+      lowerChangedName === lowerDatabaseName ||
+      lowerChangedName === `${lowerDatabaseName}-wal` ||
+      lowerChangedName === `${lowerDatabaseName}-shm` ||
+      lowerChangedName === `${lowerDatabaseName}-journal`
+    );
+  }
+
+  private startVersionChecks(): void {
+    if (
+      this.versionCheckTimer ||
+      !this.databasePath ||
+      this.disposed ||
+      this.listeners.size === 0
+    ) {
+      return;
+    }
+    this.versionCheckTimer = setInterval(() => this.checkDataVersion(), this.pollIntervalMs);
+    this.versionCheckTimer.unref();
+  }
+
+  private scheduleDataVersionCheck(): void {
+    if (this.debounceTimer) clearTimeout(this.debounceTimer);
+    this.debounceTimer = setTimeout(() => {
+      this.debounceTimer = null;
+      this.checkDataVersion();
+    }, this.debounceMs);
+    this.debounceTimer.unref();
+  }
+
+  private checkDataVersion(): void {
+    if (this.disposed || this.listeners.size === 0) return;
+    try {
+      const nextDataVersion = this.readDataVersion();
+      const previousDataVersion = this.lastDataVersion;
+      this.lastDataVersion = nextDataVersion;
+      if (previousDataVersion === null || previousDataVersion !== nextDataVersion) {
+        this.notifyInvalidation();
+      }
+    } catch (error) {
+      if (this.isTransientBusyError(error)) return;
+      this.reportError(error);
+    }
+  }
+
+  private isTransientBusyError(error: unknown): boolean {
+    if (!error || typeof error !== "object") return false;
+    const value = error as NodeJS.ErrnoException & { errcode?: number };
+    if (
+      value.code === "SQLITE_BUSY" ||
+      value.code === "SQLITE_LOCKED" ||
+      value.errcode === 5 ||
+      value.errcode === 6
+    ) {
+      return true;
+    }
+    return /\b(busy|locked)\b/i.test(value.message ?? "");
+  }
+
+  private handleWatcherError(watcher: FSWatcher, error: unknown): void {
+    if (this.watcher !== watcher) return;
+    this.watcher = null;
+    watcher.close();
+    // The data_version timer stays active as the reliable fallback.
+    if (!this.isTransientBusyError(error)) this.reportError(error);
+  }
+
+  private stopWatching(): void {
+    if (this.debounceTimer) clearTimeout(this.debounceTimer);
+    this.debounceTimer = null;
+    if (this.versionCheckTimer) clearInterval(this.versionCheckTimer);
+    this.versionCheckTimer = null;
+    this.watcher?.close();
+    this.watcher = null;
+    this.lastDataVersion = null;
+  }
+
+  private notifyInvalidation(): void {
+    for (const listener of this.listeners.values()) {
+      try {
+        listener.onInvalidate();
+      } catch (error) {
+        listener.onError?.(error);
+      }
+    }
+  }
+
+  private reportError(error: unknown): void {
+    for (const listener of this.listeners.values()) {
+      try {
+        listener.onError?.(error);
+      } catch {
+        // A diagnostic callback cannot prevent other listeners from being notified.
+      }
+    }
+  }
+}
