+test("online stored-session title transition creates one workspace task-index membership row", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "zcode-live-task-membership-"));
+  const repo = new TaskIndexRepo(join(directory, "tasks.sqlite"));
+  const provider = createProviderFreeAgentService();
+  const syncer = createZCodeTaskIndexSyncer({
+    agentService: provider.service,
+    taskIndexRepo: repo,
+  });
+  const taskService = createZCodeTaskServiceAdapter({
+    zcodeAgentService: provider.service,
+    taskIndexRepo: repo,
+    taskIndexSyncer: syncer,
+  });
+  const events: string[] = [];
+  const subscription = syncer
+    .onDynamicWorkspaceEvent({ workspacePath: workspacePathA, workspaceIdentity: workspaceIdentityA })(
+      (event) => {
+        if (
+          event.type === "workspace_task_list_changed" &&
+          event.taskId === "external-plan-session"
+        ) {
+          events.push(event.reason);
+        }
+      },
+    );
+
+  try {
+    syncer.ensureWorkspaceSubscription({
+      workspacePath: workspacePathA,
+      workspaceIdentity: workspaceIdentityA,
+    });
+    syncer.ensureWorkspaceSubscription({
+      workspacePath: workspacePathB,
+      workspaceIdentity: workspaceIdentityB,
+    });
+
+    await waitFor(async () => {
+      const [rowsA, rowsB] = await Promise.all([
+        visibleTasks(taskService, workspacePathA, workspaceIdentityA),
+        visibleTasks(taskService, workspacePathB, workspaceIdentityB),
+      ]);
+      return (
+        rowsA.some((row) => row.taskId === "anchor-" + workspaceIdentityA) &&
+        rowsB.some((row) => row.taskId === "anchor-" + workspaceIdentityB)
+      );
+    }, "both workspace subscriptions to apply their initial snapshot");
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-plan-session",
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic default",
+        titleSource: "default",
+        lastActivityAt: anchorAt + 1_000,
+      }),
+    );
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(
+      (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+        (row) => row.taskId === "external-plan-session",
+      ),
+      false,
+      "a default title must not flash as a visible task",
+    );
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-plan-session",
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic plan request",
+        titleSource: "generated",
+        lastActivityAt: anchorAt + 2_000,
+      }),
+    );
+    await waitFor(
+      async () =>
+        (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+          (row) => row.taskId === "external-plan-session",
+        ),
+      "a generated first-input title to appear in the current workspace task list",
+    );
+    const created = (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).find(
+      (row) => row.taskId === "external-plan-session",
+    );
+    assert.equal(created?.title, "Synthetic plan request");
+    assert.equal(created?.updatedAt, anchorAt + 2_000);
+    assert.deepEqual(events, ["task_created"]);
+    assert.equal(
+      (await visibleTasks(taskService, workspacePathB, workspaceIdentityB)).some(
+        (row) => row.taskId === "external-plan-session",
+      ),
+      false,
+      "the new task must remain isolated to its own workspace identity",
+    );
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-plan-session",
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic plan request",
+        titleSource: "generated",
+        lastActivityAt: anchorAt + 3_000,
+        lastAssistantPreview: "Synthetic DSP reply",
+      }),
+    );
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.deepEqual(events, ["task_created"], "reply metadata must not duplicate membership events");
+    assert.equal(provider.readSessionCalls(), 0, "stored-only summaries must not resume/read another runtime");
+  } finally {
+    subscription.dispose();
+    taskService.disposeAll();
+    await rm(directory, { recursive: true, force: true });
+  }
+});
