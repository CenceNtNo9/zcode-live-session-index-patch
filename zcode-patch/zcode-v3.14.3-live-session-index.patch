+      );
+    }
+    return initializeGroupedTaskAtTop(params);
+  };
+  const provider = createProviderFreeAgentService();
+  const syncer = createZCodeTaskIndexSyncer({
+    agentService: provider.service,
+    taskIndexRepo: repo,
+  });
+  const taskService = createZCodeTaskServiceAdapter({
