+      "the current workspace task-index subscription to become ready",
+    );
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-retry-session",
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic retry request",
+        titleSource: "generated",
+        lastActivityAt: anchorAt + 20_000,
+      }),
+    );
+    await waitFor(() => seedAttempts === 1, "the injected first seed attempt");
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    assert.equal(
+      (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+        (row) => row.taskId === "external-retry-session",
+      ),
+      false,
+    );
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-retry-session",
+        workspaceId: workspaceIdentityA,
+        title: "Synthetic retry request",
+        titleSource: "generated",
+        lastActivityAt: anchorAt + 21_000,
+        lastAssistantPreview: "Synthetic reply after retry",
+      }),
+    );
+    await waitFor(
+      async () =>
+        (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).some(
+          (row) => row.taskId === "external-retry-session",
+        ),
+      "a same-title activity update to retry and expose the task",
+    );
+
+    const visible = (await visibleTasks(taskService, workspacePathA, workspaceIdentityA)).find(
+      (row) => row.taskId === "external-retry-session",
+    );
+    assert.equal(visible?.title, "Synthetic retry request");
+    assert.equal(visible?.updatedAt, anchorAt + 21_000);
+    assert.equal(seedAttempts, 2);
+    assert.deepEqual(events, ["task_created"]);
+
+    provider.publishSummary(
+      workspaceIdentityA,
+      summary({
+        sessionId: "external-retry-session",
