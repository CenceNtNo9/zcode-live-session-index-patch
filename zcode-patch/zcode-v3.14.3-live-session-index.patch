+    assert.deepEqual(await repo.listDeletedTaskIds({
+      workspacePath: workspacePathA,
+      workspaceIdentity: workspaceIdentityA,
+    }), [targetTaskId]);
+    assert.deepEqual(events, []);
+  } finally {
+    subscription.dispose();
+    taskService.disposeAll();
+    await rm(directory, { recursive: true, force: true });
+  }
