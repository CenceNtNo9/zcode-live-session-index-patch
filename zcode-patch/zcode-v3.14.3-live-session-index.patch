+import {
+  sessionsIndexTopic,
+  workspaceConfigTopic,
+  V4_WIRE_PROTOCOL_VERSION,
+  type SessionSummary,
+  type SessionsIndexTopicWireCandidate,
+  type WorkspaceConfigTopicWireCandidate,
+} from "@zcode/shared/zcode-protocol-v4";
+import { TaskIndexRepo } from "../src/session/taskIndexRepo.js";
+import { createZCodeTaskIndexSyncer } from "../src/zcode-agent/zcodeTaskIndexSyncer.js";
+import { createZCodeTaskServiceAdapter } from "../src/zcode-agent/zcodeTaskServiceAdapter.js";
+import type { IZCodeAgentService } from "../src/zcode-agent/zcodeAgent.js";
+
+const workspaceIdentityA = "synthetic-workspace-a";
+const workspaceIdentityB = "synthetic-workspace-b";
+const workspacePathA = "/synthetic/workspace-a";
+const workspacePathB = "/synthetic/workspace-b";
+const anchorAt = 1_700_000_000_000;
+
+interface IndexSubscription {
+  id: string;
+  ordinal: number;
+  seq: number;
+}
+
+function createProviderFreeAgentService() {
+  const indexEmitters = new Map<string, Emitter<SessionsIndexTopicWireCandidate>>();
+  const configEmitters = new Map<string, Emitter<WorkspaceConfigTopicWireCandidate>>();
+  const subscriptions = new Map<string, IndexSubscription>();
+  let readSessionCalls = 0;
+  let subscriptionNumber = 0;
+
+  function indexEmitter(workspaceId: string): Emitter<SessionsIndexTopicWireCandidate> {
+    let emitter = indexEmitters.get(workspaceId);
+    if (!emitter) {
+      emitter = new Emitter<SessionsIndexTopicWireCandidate>();
+      indexEmitters.set(workspaceId, emitter);
+    }
+    return emitter;
+  }
+
+  function configEmitter(workspaceId: string): Emitter<WorkspaceConfigTopicWireCandidate> {
+    let emitter = configEmitters.get(workspaceId);
+    if (!emitter) {
+      emitter = new Emitter<WorkspaceConfigTopicWireCandidate>();
+      configEmitters.set(workspaceId, emitter);
+    }
+    return emitter;
+  }
+
+  function emitSnapshot(workspaceId: string, sub: IndexSubscription): void {
+    sub.ordinal += 1;
+    indexEmitter(workspaceId).fire({
+      wireVersion: V4_WIRE_PROTOCOL_VERSION,
+      kind: "complete",
+      deliveryKind: "initial",
+      logicalFrameId: sub.id + "-frame-" + sub.ordinal,
+      logicalFrameOrdinal: sub.ordinal,
+      topic: sessionsIndexTopic(workspaceId),
+      subscriptionId: sub.id,
+      frame: {
+        topic: sessionsIndexTopic(workspaceId),
+        subscriptionId: sub.id,
+        fromSeq: 0,
+        toSeq: 0,
+        sentAt: anchorAt,
+        payload: {
+          kind: "snapshot",
+          snapshot: {
+            protocolVersion: 1,
+            workspaceId,
+            logEpoch: "epoch-" + workspaceId,
+            sessions: [
+              summary({
+                sessionId: "anchor-" + workspaceId,
+                workspaceId,
+                title: "Synthetic readiness anchor",
+                titleSource: "generated",
+                lastActivityAt: anchorAt,
+                createdAt: anchorAt,
+              }),
+            ],
+          },
+        },
+      },
+    });
+  }
+
+  function publishSummary(workspaceId: string, next: SessionSummary): void {
+    const sub = subscriptions.get(workspaceId);
+    assert.ok(sub, "no active synthetic index subscription for " + workspaceId);
+    const fromSeq = sub.seq;
+    sub.seq += 1;
+    sub.ordinal += 1;
+    indexEmitter(workspaceId).fire({
+      wireVersion: V4_WIRE_PROTOCOL_VERSION,
+      kind: "complete",
+      deliveryKind: "online",
+      logicalFrameId: sub.id + "-frame-" + sub.ordinal,
+      logicalFrameOrdinal: sub.ordinal,
+      topic: sessionsIndexTopic(workspaceId),
+      subscriptionId: sub.id,
+      frame: {
+        topic: sessionsIndexTopic(workspaceId),
+        subscriptionId: sub.id,
+        fromSeq,
+        toSeq: sub.seq,
+        sentAt: next.lastActivityAt,
+        payload: { kind: "deltas", deltas: [{ op: "session.upserted", session: next }] },
+      },
+    });
+  }
+
+  const service = {
+    onDynamicSessionsIndexFrame: (workspace: { workspacePath: string; workspaceIdentity?: string }) =>
+      indexEmitter(resolveWorkspaceKey(workspace)).event,
+    onDynamicWorkspaceConfigFrame: (workspace: {
+      workspacePath: string;
+      workspaceIdentity?: string;
+    }) => configEmitter(resolveWorkspaceKey(workspace)).event,
+    async subscribeSessionsIndexV4(params: { workspacePath: string; workspaceIdentity?: string }) {
+      const workspaceId = resolveWorkspaceKey(params);
+      const id = "index-sub-" + ++subscriptionNumber;
+      const sub: IndexSubscription = { id, ordinal: 0, seq: 0 };
+      subscriptions.set(workspaceId, sub);
+      // Initial notification is deliberately queued before the subscribe promise continuation,
+      // matching the post-response notification race handled by the production syncer.
+      queueMicrotask(() => emitSnapshot(workspaceId, sub));
+      return { ack: { subscriptionId: id, mode: "snapshot" as const, logEpoch: "epoch-" + workspaceId } };
+    },
+    async subscribeWorkspaceConfigV4(params: {
+      workspacePath: string;
+      workspaceIdentity?: string;
+    }) {
+      const workspaceId = resolveWorkspaceKey(params);
+      const id = "config-sub-" + workspaceId;
+      queueMicrotask(() => {
+        configEmitter(workspaceId).fire({
+          wireVersion: V4_WIRE_PROTOCOL_VERSION,
+          kind: "complete",
+          deliveryKind: "initial",
+          logicalFrameId: id + "-frame-1",
+          logicalFrameOrdinal: 1,
+          topic: workspaceConfigTopic(workspaceId),
+          subscriptionId: id,
+          frame: {
+            topic: workspaceConfigTopic(workspaceId),
+            subscriptionId: id,
+            fromSeq: 0,
+            toSeq: 0,
+            sentAt: anchorAt,
+            payload: {
+              kind: "snapshot",
+              snapshot: {
+                protocolVersion: 1,
+                workspaceId,
+                logEpoch: "config-epoch-" + workspaceId,
+                config: { configOptions: [], slashCommands: [] },
+              },
+            },
+          },
+        });
+      });
+      return {
+        ack: {
+          subscriptionId: id,
+          mode: "snapshot" as const,
+          logEpoch: "config-epoch-" + workspaceId,
+        },
+      };
+    },
+    async unsubscribeSessionsIndexV4() {},
+    async unsubscribeWorkspaceConfigV4() {},
+    async listSessions() {
+      return [];
+    },
+    async readSession() {
+      readSessionCalls += 1;
+      throw new Error("Session is not active in this synthetic Desktop runtime");
+    },
+    disposeAll() {
+      for (const emitter of indexEmitters.values()) emitter.dispose();
+      for (const emitter of configEmitters.values()) emitter.dispose();
+    },
+  } as unknown as IZCodeAgentService;
+
+  return {
+    service,
+    publishSummary,
+    readSessionCalls: () => readSessionCalls,
+  };
+}
+
+function summary(
+  overrides: Pick<SessionSummary, "sessionId" | "workspaceId"> & Partial<SessionSummary>,
+): SessionSummary {
+  return {
+    sessionId: overrides.sessionId,
+    workspaceId: overrides.workspaceId,
+    title: "Synthetic default",
+    titleSource: "default",
+    phase: "completedSuccess",
+    sessionEnded: true,
+    hasBackgroundWork: false,
+    lastActivityAt: anchorAt,
+    createdAt: anchorAt,
+    ...overrides,
+  };
+}
+
+function waitFor(
+  predicate: () => boolean | Promise<boolean>,
+  message: string,
+  timeoutMs = 2_000,
+): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  return new Promise((resolve, reject) => {
+    const check = async () => {
+      if (await predicate()) {
+        resolve();
+        return;
+      }
+      if (Date.now() >= deadline) {
+        reject(new Error("Timed out waiting for " + message));
+        return;
+      }
+      setImmediate(check);
+    };
+    void check();
+  });
+}
+
+async function visibleTasks(
+  service: ReturnType<typeof createZCodeTaskServiceAdapter>,
+  workspacePath: string,
+  workspaceIdentity: string,
+) {
+  return service.listTasks({ workspacePath, workspaceIdentity });
+}
