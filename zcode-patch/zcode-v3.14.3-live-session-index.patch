@@ -299,0 +304,22 @@ export class SqliteSessionStore
+  subscribeExternalSessionIndexInvalidation(
+    onInvalidate: () => void,
+    onError?: (error: unknown) => void,
+  ): () => void {
+    this.externalSessionIndexWatcher ??= new SqliteExternalSessionIndexWatcher(
+      this.dbPath,
+      () => this.readDataVersion(),
+    );
+    return this.externalSessionIndexWatcher.subscribe(onInvalidate, onError);
+  }
+
+  private readDataVersion(): number {
+    const result = this.db.prepare("PRAGMA data_version").get() as
+      | { data_version?: unknown }
+      | undefined;
+    const dataVersion = Number(result?.data_version);
+    if (!Number.isSafeInteger(dataVersion) || dataVersion < 0) {
+      throw new Error(`SQLite returned an invalid data_version for ${this.dbPath}`);
+    }
+    return dataVersion;
+  }
+
